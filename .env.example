# ============================================================
# 复制本文件为 .env,按需填写后重启程序。# 开头的是注释。
# ============================================================

# ---------- 服务 ----------
APP_TITLE=优学东方·原版教研助手
APP_PORT=8000
# 首次启动自动创建的管理员(教研负责人)账号;密码留空会随机生成并打印在启动窗口
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# 每人每天最多提问次数,0 = 不限
DAILY_MESSAGE_LIMIT=0

# ---------- 大模型(必填,任选一家 OpenAI 兼容接口) ----------
# 方案A:豆包(火山方舟)——和扣子同一家,迁移最顺。
#   火山方舟控制台 → API Key 管理 创建密钥;开通模型后把"模型 ID"填到 LLM_MODEL。
#   2026-10 方舟在售主力型号(ID 会随版本更新,以方舟文档"模型列表"为准):
#     doubao-seed-2-1-pro-260915   效果最好,推荐
#     doubao-seed-2-1-lite-260915  更快更便宜,限流额度高
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_API_KEY=
LLM_MODEL=doubao-seed-2-1-pro-260915
# 豆包 2.x 默认开启"深度思考":规则遵守更好,但回答前要多等十几秒。
# 老师嫌慢时取消下一行注释即可关闭(官方参数 thinking.type=disabled)
# LLM_EXTRA_BODY={"thinking": {"type": "disabled"}}

# 方案B:DeepSeek
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# 方案C:通义千问(阿里云百炼)
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

LLM_TEMPERATURE=0.4
# 单次回答最大长度(token)。90 分钟教案、培训方案较长,建议不低于 8192
LLM_MAX_TOKENS=8192
# 模型不支持 function calling 时改为 false,并把 SEARCH_MODE 改为 auto
LLM_SUPPORTS_TOOLS=true

# ---------- 向量模型(建议配置,检索更准;不填则只用关键词检索) ----------
# 默认与大模型同一家、同一个密钥。
# 豆包:方舟目前提供的是多模态向量模型,开通后填 doubao-embedding-vision-251215,
#       程序会自动走官方多模态向量接口并加上检索指令,无需其他设置。
# 通义:EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  EMBED_MODEL=text-embedding-v3
# DeepSeek 没有向量模型,可单独配豆包或通义的向量模型(填 EMBED_BASE_URL / EMBED_API_KEY)
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=
# 向量维度:留空即可。豆包多模态向量默认按 1024 维调用(官方支持 2048 或降维到 1024)
EMBED_DIMENSIONS=
EMBED_BATCH=10
EMBED_CONCURRENCY=5
# 向量相似度低于该值的片段不采用。换向量模型后到后台"检索测试"里观察再调(0.2~0.5)
KB_MIN_VECTOR_SCORE=0.3

# ---------- 联网搜索(原则5、政策核实需要) ----------
# 博查 Web Search API:到博查开放平台 open.bocha.cn 注册,在"API KEY 管理"获取密钥并充值
SEARCH_PROVIDER=none
# SEARCH_PROVIDER=bocha
SEARCH_API_KEY=
SEARCH_ENDPOINT=https://api.bocha.cn/v1/web-search
# tool = 由模型判断何时搜索(推荐);auto = 问题含"中考/政策/最新/查一下"等词时程序先搜再答
SEARCH_MODE=tool
SEARCH_COUNT=8

# ---------- 知识库检索 ----------
KB_TOP_K=8
KB_CHUNK_SIZE=600
KB_CHUNK_OVERLAP=80
KB_MAX_CONTEXT_CHARS=6000

# ---------- 对话 ----------
# 每次带给模型的历史消息条数
HISTORY_MESSAGES=12
ATTACHMENT_MAX_CHARS=30000
MAX_UPLOAD_MB=50

# ---------- 扣子插件接口(迁移扣子时用,见 coze/迁移指南.md) ----------
# 设置一串足够长的随机字符即开启 /api/plugin/kb_search
PLUGIN_API_KEY=
