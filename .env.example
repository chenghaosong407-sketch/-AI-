# ============================================================
# 复制本文件为 .env,按需填写后重启程序。# 开头的是注释。
# ============================================================

# ---------- 服务 ----------
APP_TITLE=优学东方·原版教研助手
APP_PORT=8000
# 首次启动自动创建的管理员(教研负责人)账号;密码留空会随机生成并打印在启动窗口
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# 每人每天最多提问次数,0 = 不限
DAILY_MESSAGE_LIMIT=0

# ---------- 大模型(必填,任选一家 OpenAI 兼容接口) ----------
# 方案A:豆包(火山方舟)——和扣子同一家,迁移最顺。
#   控制台 → API Key 管理 创建密钥;模型广场开通模型后,把"模型 ID"填到 LLM_MODEL
LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
LLM_API_KEY=
LLM_MODEL=
# 豆包深度思考模型如需关闭思考(更快更省),取消下一行注释
# LLM_EXTRA_BODY={"thinking": {"type": "disabled"}}

# 方案B:DeepSeek
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# 方案C:通义千问(阿里云百炼)
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_MODEL=qwen-plus

LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=4096
# 模型不支持 function calling 时改为 false,并把 SEARCH_MODE 改为 auto
LLM_SUPPORTS_TOOLS=true

# ---------- 向量模型(建议配置,检索更准;不填则只用关键词检索) ----------
# 默认与大模型同一家、同一个密钥。豆包:在方舟开通文本向量模型后填模型 ID
# 通义:EMBED_MODEL=text-embedding-v3   DeepSeek 没有向量模型,可单独配通义或豆包
EMBED_BASE_URL=
EMBED_API_KEY=
EMBED_MODEL=
EMBED_BATCH=10
# 向量相似度低于该值的片段不采用(换向量模型后可能需要调,范围 0.2~0.5)
KB_MIN_VECTOR_SCORE=0.3

# ---------- 联网搜索(原则5、政策核实需要) ----------
# 博查 Web Search API:open.bochaai.com 注册获取 API Key
SEARCH_PROVIDER=none
# SEARCH_PROVIDER=bocha
SEARCH_API_KEY=
SEARCH_ENDPOINT=https://api.bochaai.com/v1/web-search
# tool = 由模型判断何时搜索(推荐);auto = 问题含"中考/政策/最新/查一下"等词时程序先搜再答
SEARCH_MODE=tool
SEARCH_COUNT=8

# ---------- 知识库检索 ----------
KB_TOP_K=8
KB_CHUNK_SIZE=600
KB_CHUNK_OVERLAP=80
KB_MAX_CONTEXT_CHARS=6000

# ---------- 对话 ----------
# 每次带给模型的历史消息条数
HISTORY_MESSAGES=12
ATTACHMENT_MAX_CHARS=30000
MAX_UPLOAD_MB=50

# ---------- 扣子插件接口(迁移扣子时用,见 coze/迁移指南.md) ----------
# 设置一串足够长的随机字符即开启 /api/plugin/kb_search
PLUGIN_API_KEY=
